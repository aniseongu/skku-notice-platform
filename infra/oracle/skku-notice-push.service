[Unit]
Description=Deliver user notice web push notifications
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=skku-push
Group=skku-push
WorkingDirectory=/opt/skku-notice-platform
Environment=PYTHONPATH=/opt/skku-notice-platform/src
EnvironmentFile=/etc/skku-notice/worker.env
EnvironmentFile=/etc/skku-notice/push.env
# 새 문의 메일(선택): RESEND_API_KEY, FEEDBACK_NOTIFY_EMAIL. 파일이 없으면 메일은 보내지 않는다.
EnvironmentFile=-/etc/skku-notice/feedback.env
RuntimeDirectory=skku-notice-push
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/flock -n /run/skku-notice-push/push.lock /opt/skku-notice-push/bin/python -m skku_notice.push_collection
TimeoutStartSec=300
MemoryMax=192M
MemorySwapMax=256M
CPUQuota=70%
NoNewPrivileges=true
PrivateTmp=true
