[Unit]
Description=Collect shared SKKU notices
Wants=network-online.target
After=network-online.target
# 수집이 끝나면 바로 글자 읽기와 AI 판정을 돌려 새 글에 설명·요약이 곧바로 붙게 한다(판정은 글자 읽기를 기다리지 않는다).
OnSuccess=skku-notice-ocr.service skku-notice-judge.service

[Service]
Type=oneshot
User=skku
WorkingDirectory=/opt/skku-notice-platform
Environment=PYTHONPATH=/opt/skku-notice-platform/src
EnvironmentFile=/etc/skku-notice/worker.env
RuntimeDirectory=skku-notice
RuntimeDirectoryMode=0755
ExecStart=/usr/bin/flock -n /run/skku-notice/crawl.lock /opt/skku-notice-platform/.venv/bin/python -m skku_notice.scheduled_collection
TimeoutStartSec=1200
NoNewPrivileges=true
PrivateTmp=true
